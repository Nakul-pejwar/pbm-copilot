# Optional: enables real LLM explanations in /explain/{claim_id}
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Optional: when set, write/explain API endpoints require this value
# in the X-API-Token header (used by the Superset Copilot extension settings).
PBM_API_TOKEN=

# Origin of the Superset frontend that may call the API from the browser (CORS).
# Comma-separate multiple origins if needed.
SUPERSET_ORIGIN=http://localhost:8088

# Change this for anything beyond a local demo
SUPERSET_SECRET_KEY=pbm-demo-change-me
